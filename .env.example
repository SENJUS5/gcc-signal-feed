# Copy this file to .env and fill in real values. .env is git-ignored.

# Supabase: Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Secret / service_role key: laptop scripts only (writes data). Never put this on Streamlit Cloud.
SUPABASE_SERVICE_KEY=your_service_role_key_here
# Publishable / anon key: the live website (read-only, protected by RLS policies)
SUPABASE_ANON_KEY=your_anon_key_here

# Gemini: aistudio.google.com > Get API key (free tier)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# Voyage: dashboard.voyageai.com (embeddings for the Ask box)
VOYAGE_API_KEY=pa-your_voyage_key_here

# Optional backup for article reading if Gemini hits its limit
OLLAMA_MODEL=qwen2.5:7b
