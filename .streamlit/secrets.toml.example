# Keys the WEBSITE needs. Paste these (with real values) into Streamlit Cloud:
#   App settings > Secrets. For local runs the app reads .env instead.
# Never add SUPABASE_SERVICE_KEY here: the website only reads, with the anon key.

SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY = "your_anon_key_here"
GEMINI_API_KEY = "your_gemini_key_here"
GEMINI_MODEL = "gemini-3.8-flash"
VOYAGE_API_KEY = "pa-your_voyage_key_here"
